SECKILL_MYSQL_ROOT_PASSWORD=replace-with-local-mysql-password
SECKILL_REDIS_PASSWORD=replace-with-local-redis-password
SECKILL_RABBITMQ_USER=seckill
SECKILL_RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
SECKILL_JWT_SECRET=replace-with-at-least-32-random-characters
SECKILL_MOCK_PAYMENT_SECRET=replace-with-another-32-character-secret
SECKILL_ADMIN_EMAIL=admin@example.com
SECKILL_ADMIN_PASSWORD=replace-with-at-least-12-characters
# 仅在无 MySQL 的本地演示中设置为 memory，生产和 Compose 保持 mysql。
SECKILL_COMMERCE_STORE=mysql
